// ─── Branch Stock List (Tab 0) — items to issue FROM ─────────────────────────

class _BranchStockList extends ConsumerWidget {
  const _BranchStockList();

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final search = ref.watch(searchQueryProvider);
    final stockAsync = ref.watch(branchStockProvider(search));
    final cart = ref.watch(issueCartProvider);
    final selectedOutlet = ref.watch(selectedOutletProvider);

    final cartSkus = cart.map((c) => c.stockItem.sku).toSet();

    return stockAsync.when(
      loading: () => const Center(child: CircularProgressIndicator()),
      error: (e, _) => Center(
        child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
          Icon(PhosphorIcons.warning(), size: 40, color: AppColors.kError),
          const SizedBox(height: 12),
          Text('Failed to load branch stock', style: const TextStyle(color: AppColors.kError)),
          const SizedBox(height: 8),
          TextButton(onPressed: () => ref.invalidate(branchStockProvider), child: const Text('Retry')),
        ]),
      ),
      data: (items) {
        if (items.isEmpty) {
          return Center(
            child: Column(mainAxisAlignment: MainAxisAlignment.center, children: [
              Icon(PhosphorIcons.package(), size: 48, color: AppColors.kDivider),
              const SizedBox(height: 12),
              const Text('No stock items found', style: TextStyle(color: AppColors.kTextSecondary)),
            ]),
          );
        }

        // Group by category
        final Map<String, List<BranchStockItem>> grouped = {};
        for (final item in items) {
          grouped.putIfAbsent(item.category, () => []).add(item);
        }

        return ListView(
          padding: const EdgeInsets.all(16),
          children: [
            // Table header
            _StockTableHeader(),
            const SizedBox(height: 8),
            ...grouped.entries.map((entry) => Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Padding(
                  padding: const EdgeInsets.fromLTRB(0, 12, 0, 6),
                  child: Row(children: [
                    Container(width: 3, height: 14, color: AppColors.kPrimary,
                        margin: const EdgeInsets.only(right: 8)),
                    Text(entry.key,
                        style: const TextStyle(fontSize: 12, fontWeight: FontWeight.bold,
                            color: AppColors.kTextSecondary, letterSpacing: 0.5)),
                  ]),
                ),
                ...entry.value.map((item) => _BranchStockRow(
                  item: item,
                  inCart: cartSkus.contains(item.sku),
                  outlet: selectedOutlet!,
                  onAdd: () => _addToCart(context, ref, item, selectedOutlet),
                )),
              ],
            )).toList(),
          ],
        );
      },
    );
  }

  void _addToCart(BuildContext context, WidgetRef ref, BranchStockItem item, PosOutlet outlet) {
    showDialog(
      context: context,
      builder: (_) => _AddToCartDialog(item: item, outlet: outlet),
    );
  }
}

