    if (outlet == null) {
      return Container(
        color: Colors.white,
        padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 14),
        child: const Text('Select an outlet above to begin issuing stock.',
            style: TextStyle(color: AppColors.kTextSecondary, fontSize: 13)),
