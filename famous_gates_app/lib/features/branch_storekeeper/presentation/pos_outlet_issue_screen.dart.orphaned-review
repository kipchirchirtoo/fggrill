// ─── Outlet Selector Chips ────────────────────────────────────────────────────

class _OutletSelector extends ConsumerWidget {
  const _OutletSelector();

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final outletsAsync = ref.watch(posOutletsProvider);
    final selected = ref.watch(selectedOutletProvider);

    return Container(
      color: Colors.white,
      padding: const EdgeInsets.fromLTRB(20, 16, 20, 14),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Text('POS Outlets',
              style: TextStyle(fontSize: 15, fontWeight: FontWeight.bold)),
          const SizedBox(height: 4),
          const Text('Choose the salable outlet first. Every issue updates that outlet, not generic branch stock.',
              style: TextStyle(fontSize: 12, color: AppColors.kTextSecondary)),
          const SizedBox(height: 12),
          outletsAsync.when(
            loading: () => const SizedBox(height: 36, child: Center(child: LinearProgressIndicator())),
            error: (e, _) => Text('Failed to load outlets: $e',
                style: const TextStyle(color: AppColors.kError, fontSize: 12)),
            data: (outlets) => Wrap(
              spacing: 8,
              runSpacing: 8,
              children: outlets.map((outlet) {
                final isSelected = selected?.id == outlet.id;
                return _OutletChip(outlet: outlet, isSelected: isSelected,
                  onTap: () {
                    ref.read(selectedOutletProvider.notifier).state =
                        isSelected ? null : outlet;
                    ref.read(activeTabProvider.notifier).state = 0;
                  },
                );
              }).toList(),
            ),
          ),
        ],
      ),
    );
  }
}

class _OutletChip extends StatelessWidget {
  final PosOutlet outlet;
  final bool isSelected;
  final VoidCallback onTap;

  const _OutletChip({required this.outlet, required this.isSelected, required this.onTap});

  IconData get _icon {
    switch (outlet.outletType) {
      case 'cashier': return PhosphorIcons.receipt();
      case 'main_bar':
      case 'executive_bar':
      case 'sports_bar': return PhosphorIcons.wine();
      case 'restaurant': return PhosphorIcons.forkKnife();
      default: return PhosphorIcons.storefront();
    }
  }

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onTap: onTap,
      child: AnimatedContainer(
        duration: const Duration(milliseconds: 150),
        padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 8),
        decoration: BoxDecoration(
          color: isSelected ? AppColors.kPrimary : Colors.white,
          borderRadius: BorderRadius.circular(8),
          border: Border.all(
            color: isSelected ? AppColors.kPrimary : AppColors.kDivider,
            width: isSelected ? 2 : 1,
          ),
        ),
        child: Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            Icon(_icon, size: 16, color: isSelected ? Colors.white : AppColors.kTextSecondary),
            const SizedBox(width: 6),
            Text('${outlet.name} (${outlet.itemCount})',
                style: TextStyle(
                  fontSize: 13,
                  fontWeight: isSelected ? FontWeight.bold : FontWeight.normal,
                  color: isSelected ? Colors.white : AppColors.kTextPrimary,
                )),
          ],
        ),
      ),
    );
  }
}

// ─── Sub-Tab Bar ──────────────────────────────────────────────────────────────

class _SubTabBar extends ConsumerWidget {
  final int activeTab;
  const _SubTabBar({required this.activeTab});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final tabs = ['Branch Stock (Issue)', 'Outlet Current Stock', 'Movement Log'];
    return Container(
      color: AppColors.kSurface,
      padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 0),
      child: Row(
        children: tabs.asMap().entries.map((e) {
          final i = e.key;
          final label = e.value;
          final active = activeTab == i;
          return GestureDetector(
            onTap: () => ref.read(activeTabProvider.notifier).state = i,
            child: Container(
              padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
              decoration: BoxDecoration(
                border: Border(
                  bottom: BorderSide(
                    color: active ? AppColors.kPrimary : Colors.transparent,
                    width: 2,
                  ),
                ),
              ),
              child: Text(label,
                  style: TextStyle(
                    fontSize: 13,
                    fontWeight: active ? FontWeight.bold : FontWeight.normal,
                    color: active ? AppColors.kPrimary : AppColors.kTextSecondary,
                  )),
            ),
          );
        }).toList(),
      ),
