                  padding: const EdgeInsets.all(16),
                  itemCount: movements.length,
                  separatorBuilder: (_, __) => const Divider(height: 8, color: AppColors.kDivider),
                  itemBuilder: (_, i) {
                    final m = movements[i];
                    final typeColor = m.movementType == 'outlet_issue'
                        ? AppColors.kPrimary
                        : m.movementType == 'stock_in'
                            ? AppColors.kSuccess
                            : AppColors.kWarning;

                    return ListTile(
                      contentPadding: const EdgeInsets.symmetric(horizontal: 8, vertical: 4),
                      leading: Container(
                        width: 40, height: 40,
                        decoration: BoxDecoration(
                          color: typeColor.withOpacity(0.1),
                          borderRadius: BorderRadius.circular(8),
                        ),
                        child: Icon(
                          m.movementType == 'outlet_issue'
                              ? PhosphorIcons.arrowBendDownRight()
                              : PhosphorIcons.arrowsLeftRight(),
                          size: 20, color: typeColor,
                        ),
                      ),
                      title: Text(m.itemName,
                          style: const TextStyle(fontSize: 13, fontWeight: FontWeight.w600)),
                      subtitle: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          if (m.outletName != null)
                            Text('→ ${m.outletName}',
                                style: const TextStyle(fontSize: 12, color: AppColors.kPrimary)),
                          Text('By ${m.performedBy} • ${_fmtDate(m.createdAt)}',
                              style: const TextStyle(fontSize: 11, color: AppColors.kTextSecondary)),
                          if (m.notes != null && m.notes!.isNotEmpty)
                            Text(m.notes!,
                                style: const TextStyle(fontSize: 11, color: AppColors.kTextSecondary,
                                    fontStyle: FontStyle.italic)),
                        ],
                      ),
                      trailing: Container(
                        padding: const EdgeInsets.symmetric(horizontal: 10, vertical: 6),
                        decoration: BoxDecoration(
                          color: typeColor.withOpacity(0.1),
                          borderRadius: BorderRadius.circular(6),
                        ),
                        child: Text('${m.quantity} ${m.unit}',
                            style: TextStyle(fontSize: 13, fontWeight: FontWeight.bold,
                                color: typeColor)),
                      ),
                      isThreeLine: true,
                    );
                  },
                );
              },
            ),
          ),
        ],
      ),
    );
  }

  String _fmtDate(DateTime dt) {
    final now = DateTime.now();
    final diff = now.difference(dt);
    if (diff.inMinutes < 60) return '${diff.inMinutes}m ago';
    if (diff.inHours < 24) return '${diff.inHours}h ago';
    return '${dt.day}/${dt.month}/${dt.year}  ${dt.hour.toString().padLeft(2, '0')}:${dt.minute.toString().padLeft(2, '0')}';
  }
}
