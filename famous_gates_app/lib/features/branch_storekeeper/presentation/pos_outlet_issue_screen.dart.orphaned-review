        data: (items) {
          final totalItems = items.length;
          final available = items.where((i) => i.currentStock > 0).length;
          final lowZero = items.where((i) => i.currentStock <= 0).length;
          final totalValue = items.fold(0.0, (s, i) => s + i.currentStock * i.sellingPrice);

          return Row(
            children: [
              _StatCard(icon: PhosphorIcons.storefront(), label: 'OUTLET ITEMS',
                  value: '$totalItems', color: AppColors.kPrimary),
              const SizedBox(width: 12),
              _StatCard(icon: PhosphorIcons.checkCircle(), label: 'AVAILABLE',
                  value: '$available', color: AppColors.kSuccess),
              const SizedBox(width: 12),
              _StatCard(icon: PhosphorIcons.warning(), label: 'LOW / ZERO',
                  value: '$lowZero', color: AppColors.kWarning),
              const SizedBox(width: 12),
              _StatCard(icon: PhosphorIcons.currencyDollar(), label: 'OUTLET STOCK VALUE',
                  value: 'KES ${totalValue.toStringAsFixed(2)}', color: AppColors.kAccent),
            ],
          );
        },
      ),
    );
  }
}

