        content: const Text('Remove all items from the issue cart?'),
        actions: [
          TextButton(onPressed: () => Navigator.pop(ctx), child: const Text('Cancel')),
          ElevatedButton(
            onPressed: () {
              ref.read(issueCartProvider.notifier).state = [];
              Navigator.pop(ctx);
            },
            style: ElevatedButton.styleFrom(backgroundColor: AppColors.kError),
            child: const Text('Clear All'),
          ),
        ],
      ),
    );
  }

  void _showIssueConfirmFromCart(BuildContext context, WidgetRef ref, PosOutlet outlet, List<IssueCartItem> cart) {
    showDialog(
      context: context,
      builder: (ctx) => _IssueConfirmDialog(
        outlet: outlet,
        cart: cart,
        onConfirmed: (notes) async {
          final items = cart.map((c) => {
            'sku': c.stockItem.sku,
            'quantity': c.quantity,
            'item_name': c.stockItem.itemName,
            'unit': c.stockItem.unit,
          }).toList();
          await BranchStorekeeperApiService.issueToOutlet(outletId: outlet.id, items: items, notes: notes);
          ref.read(issueCartProvider.notifier).state = [];
          ref.invalidate(branchStockProvider);
          ref.invalidate(outletStockProvider(outlet.id));
          ref.invalidate(stockMovementsProvider(outlet.id));
          if (ctx.mounted) {
            Navigator.of(ctx).pop();
            ScaffoldMessenger.of(context).showSnackBar(SnackBar(
              content: Text('Stock issued to ${outlet.name} successfully'),
              backgroundColor: AppColors.kSuccess,
            ));
          }
        },
      ),
    );
  }
}

class _CartItemTile extends ConsumerWidget {
  final IssueCartItem item;
  final VoidCallback onRemove;
  final ValueChanged<double> onQtyChanged;

  const _CartItemTile({required this.item, required this.onRemove, required this.onQtyChanged});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final qtyCtrl = TextEditingController(text: item.quantity.toStringAsFixed(
        item.quantity % 1 == 0 ? 0 : 1));

    return Container(
      padding: const EdgeInsets.all(10),
      decoration: BoxDecoration(
        color: AppColors.kSurface,
        borderRadius: BorderRadius.circular(8),
        border: Border.all(color: AppColors.kDivider),
