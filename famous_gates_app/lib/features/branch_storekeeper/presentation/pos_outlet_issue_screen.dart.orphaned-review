      case 'stock_in': return 'Stock In';
      case 'adjustment': return 'Adjustment';
      case 'wastage': return 'Wastage';
      default: return movement.movementType;
    }
  }

  Color get _typeColor {
    switch (movement.movementType) {
      case 'outlet_issue': return AppColors.kPrimary;
      case 'stock_in': return AppColors.kSuccess;
      case 'wastage': return AppColors.kError;
      default: return AppColors.kWarning;
    }
