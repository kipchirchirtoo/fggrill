              Icon(PhosphorIcons.clipboardText(), size: 20, color: AppColors.kPrimary),
              const SizedBox(width: 10),
              const Text('Production Ledger',
                  style: TextStyle(fontSize: 17, fontWeight: FontWeight.bold)),
