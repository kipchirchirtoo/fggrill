// ─── Mock API Service ─────────────────────────────────────────────────────────

class BranchStorekeeperApiService {
  static const String _baseUrl = 'http://localhost:5000/api';

  /// GET /api/storekeeping/branch-stock
  static Future<List<BranchStockItem>> fetchBranchStock({String? search}) async {
    await Future.delayed(const Duration(milliseconds: 600));
    final items = [
      const BranchStockItem(sku: 'BEV-JUC-001', itemName: 'Mango Juice 1L', category: 'Beverages', quantity: 48, unit: 'PCS', costPrice: 120),
      const BranchStockItem(sku: 'BEV-WTR-002', itemName: 'Mineral Water 500ml', category: 'Beverages', quantity: 200, unit: 'PCS', costPrice: 35),
      const BranchStockItem(sku: 'FOD-RCE-001', itemName: 'Basmati Rice 1kg', category: 'Dry Foods', quantity: 30, unit: 'KG', costPrice: 145),
      const BranchStockItem(sku: 'FOD-OIL-002', itemName: 'Cooking Oil 5L', category: 'Dry Foods', quantity: 12, unit: 'JERRICAN', costPrice: 850),
      const BranchStockItem(sku: 'CLS-BTL-001', itemName: 'Tusker Beer 500ml', category: 'Alcoholic', quantity: 144, unit: 'BTL', costPrice: 180),
      const BranchStockItem(sku: 'CLS-BTL-002', itemName: 'Guinness 500ml', category: 'Alcoholic', quantity: 72, unit: 'BTL', costPrice: 210),
      const BranchStockItem(sku: 'DRY-SGR-001', itemName: 'Sugar 1kg', category: 'Dry Foods', quantity: 25, unit: 'KG', costPrice: 120),
      const BranchStockItem(sku: 'CLS-SFT-001', itemName: 'Coca-Cola 300ml', category: 'Soft Drinks', quantity: 96, unit: 'BTL', costPrice: 55),
      const BranchStockItem(sku: 'PRO-MTN-001', itemName: 'Beef Fillet 1kg', category: 'Proteins', quantity: 8, unit: 'KG', costPrice: 850),
      const BranchStockItem(sku: 'PRO-CHK-002', itemName: 'Whole Chicken 1.5kg', category: 'Proteins', quantity: 15, unit: 'PC', costPrice: 520),
    ];
    if (search == null || search.isEmpty) return items;
    final q = search.toLowerCase();
    return items.where((i) =>
      i.itemName.toLowerCase().contains(q) ||
      i.sku.toLowerCase().contains(q) ||
      i.category.toLowerCase().contains(q)
    ).toList();
  }

  /// GET /api/outlet-pos/outlets
  static Future<List<PosOutlet>> fetchPosOutlets() async {
    await Future.delayed(const Duration(milliseconds: 400));
    return const [
      PosOutlet(id: 'outlet-001', name: 'Cashier', outletType: 'cashier', itemCount: 0),
      PosOutlet(id: 'outlet-002', name: 'Main Bar', outletType: 'main_bar', itemCount: 117),
      PosOutlet(id: 'outlet-003', name: 'Non-consumables', outletType: 'non_consumables', itemCount: 3),
      PosOutlet(id: 'outlet-004', name: 'Restaurant', outletType: 'restaurant', itemCount: 156),
    ];
  }

  /// GET /api/outlet-pos/outlets/:id/items
  static Future<List<OutletStockItem>> fetchOutletStock(String outletId) async {
    await Future.delayed(const Duration(milliseconds: 500));
    return [
      OutletStockItem(id: 'oi-001', sku: 'BEV-JUC-001', itemName: 'Mango Juice 1L', category: 'Beverages', currentStock: 0, sellableStock: 0, unit: 'PCS', sellingPrice: 200),
      OutletStockItem(id: 'oi-002', sku: 'CLS-BTL-001', itemName: 'Tusker Beer 500ml', category: 'Alcoholic', currentStock: 24, sellableStock: 24, unit: 'BTL', sellingPrice: 300),
      OutletStockItem(id: 'oi-003', sku: 'CLS-SFT-001', itemName: 'Coca-Cola 300ml', category: 'Soft Drinks', currentStock: 0, sellableStock: 0, unit: 'BTL', sellingPrice: 100),
      OutletStockItem(id: 'oi-004', sku: 'PRO-CHK-002', itemName: 'Whole Chicken 1.5kg', category: 'Proteins', currentStock: 3, sellableStock: 3, unit: 'PC', sellingPrice: 900),
    ];
  }

  /// GET /api/storekeeping/stock-movements
  static Future<List<StockMovement>> fetchStockMovements({String? outletId}) async {
    await Future.delayed(const Duration(milliseconds: 500));
    return [
      StockMovement(id: 'mv-001', itemName: 'Tusker Beer 500ml', movementType: 'outlet_issue', quantity: 24, unit: 'BTL', performedBy: 'James Pkemoi', createdAt: DateTime.now().subtract(const Duration(hours: 2)), notes: 'Issued to Main Bar', outletName: 'Main Bar'),
      StockMovement(id: 'mv-002', itemName: 'Mango Juice 1L', movementType: 'outlet_issue', quantity: 12, unit: 'PCS', performedBy: 'James Pkemoi', createdAt: DateTime.now().subtract(const Duration(hours: 5)), notes: 'Issued to Restaurant', outletName: 'Restaurant'),
      StockMovement(id: 'mv-003', itemName: 'Basmati Rice 1kg', movementType: 'outlet_issue', quantity: 5, unit: 'KG', performedBy: 'Alice Wanjiku', createdAt: DateTime.now().subtract(const Duration(days: 1)), notes: 'Morning preparation', outletName: 'Restaurant'),
      StockMovement(id: 'mv-004', itemName: 'Coca-Cola 300ml', movementType: 'outlet_issue', quantity: 48, unit: 'BTL', performedBy: 'James Pkemoi', createdAt: DateTime.now().subtract(const Duration(days: 1, hours: 3)), notes: 'Bar restock', outletName: 'Main Bar'),
    ];
  }

  /// POST /api/storekeeping/branch-stock/out  (issue to outlet)
  static Future<Map<String, dynamic>> issueToOutlet({
    required String outletId,
    required List<Map<String, dynamic>> items,
    required String notes,
  }) async {
    await Future.delayed(const Duration(milliseconds: 900));
    return {'success': true, 'message': 'Stock issued successfully', 'movement_ids': List.generate(items.length, (i) => 'mv-new-$i')};
  }
}

// ─── Riverpod Providers ───────────────────────────────────────────────────────

final selectedOutletProvider = StateProvider<PosOutlet?>((ref) => null);
final issueCartProvider = StateProvider<List<IssueCartItem>>((ref) => []);
final searchQueryProvider = StateProvider<String>((ref) => '');
final activeTabProvider = StateProvider<int>((ref) => 0); // 0=stock list, 1=outlet stock, 2=movements

final posOutletsProvider = FutureProvider<List<PosOutlet>>((ref) async {
  return BranchStorekeeperApiService.fetchPosOutlets();
});

final branchStockProvider = FutureProvider.family<List<BranchStockItem>, String>((ref, search) async {
  return BranchStorekeeperApiService.fetchBranchStock(search: search);
});

final outletStockProvider = FutureProvider.family<List<OutletStockItem>, String>((ref, outletId) async {
  return BranchStorekeeperApiService.fetchOutletStock(outletId);
});

final stockMovementsProvider = FutureProvider.family<List<StockMovement>, String?>((ref, outletId) async {
  return BranchStorekeeperApiService.fetchStockMovements(outletId: outletId);
});

