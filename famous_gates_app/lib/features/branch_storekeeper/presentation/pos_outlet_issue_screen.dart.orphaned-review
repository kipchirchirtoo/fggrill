      child: Column(crossAxisAlignment: CrossAxisAlignment.start, children: [
        Row(children: [
          Expanded(child: Text(item.stockItem.itemName,
              style: const TextStyle(fontSize: 13, fontWeight: FontWeight.w600),
              overflow: TextOverflow.ellipsis)),
          GestureDetector(
            onTap: onRemove,
            child: Icon(PhosphorIcons.x(), size: 16, color: AppColors.kError),
          ),
        ]),
        const SizedBox(height: 4),
        Text(item.stockItem.sku,
            style: const TextStyle(fontSize: 11, color: AppColors.kTextSecondary,
                fontFamily: 'monospace')),
        const SizedBox(height: 8),
        Row(children: [
          // Decrement
          _QtyButton(
            icon: PhosphorIcons.minus(),
            onTap: () {
              if (item.quantity > 1) onQtyChanged(item.quantity - 1);
            },
          ),
          const SizedBox(width: 8),
          Expanded(
            child: TextField(
              controller: qtyCtrl,
              keyboardType: const TextInputType.numberWithOptions(decimal: true),
              textAlign: TextAlign.center,
              style: const TextStyle(fontSize: 14, fontWeight: FontWeight.bold),
              decoration: const InputDecoration(
                isDense: true,
                contentPadding: EdgeInsets.symmetric(vertical: 6, horizontal: 8),
              ),
              onSubmitted: (val) {
                final parsed = double.tryParse(val);
                if (parsed != null && parsed > 0 && parsed <= item.stockItem.quantity) {
                  onQtyChanged(parsed);
                } else {
                  qtyCtrl.text = item.quantity.toStringAsFixed(0);
                }
              },
            ),
          ),
          const SizedBox(width: 8),
          // Increment
          _QtyButton(
            icon: PhosphorIcons.plus(),
            onTap: () {
              if (item.quantity < item.stockItem.quantity) onQtyChanged(item.quantity + 1);
            },
          ),
          const SizedBox(width: 8),
          Text(item.stockItem.unit,
              style: const TextStyle(fontSize: 12, color: AppColors.kTextSecondary)),
        ]),
        const SizedBox(height: 4),
        Text('Max: ${item.stockItem.quantity} ${item.stockItem.unit} in store',
            style: const TextStyle(fontSize: 10, color: AppColors.kTextSecondary)),
      ]),
    );
  }
}

