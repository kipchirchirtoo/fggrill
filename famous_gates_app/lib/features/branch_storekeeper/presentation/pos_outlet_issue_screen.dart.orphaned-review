class PosOutletIssueScreen extends ConsumerStatefulWidget {
  const PosOutletIssueScreen({super.key});

  @override
  ConsumerState<PosOutletIssueScreen> createState() => _PosOutletIssueScreenState();
}

class _PosOutletIssueScreenState extends ConsumerState<PosOutletIssueScreen> {
  final TextEditingController _searchCtrl = TextEditingController();
  Timer? _searchDebounce;

  @override
  void dispose() {
    _searchCtrl.dispose();
    _searchDebounce?.cancel();
    super.dispose();
  }

  void _onSearchChanged(String val) {
    _searchDebounce?.cancel();
    _searchDebounce = Timer(const Duration(milliseconds: 350), () {
      ref.read(searchQueryProvider.notifier).state = val;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: AppColors.kSurface,
      body: Column(
        children: [
          _TopBar(searchCtrl: _searchCtrl, onSearchChanged: _onSearchChanged),
          Expanded(
            child: Row(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: const [
                _LeftPanel(),
                VerticalDivider(width: 1, color: AppColors.kDivider),
                Expanded(child: _MainContent()),
                VerticalDivider(width: 1, color: AppColors.kDivider),
                _IssueCartPanel(),
              ],
            ),
          ),
        ],
      ),
    );
  }
}

// ─── Top Bar ──────────────────────────────────────────────────────────────────

class _TopBar extends ConsumerWidget {
  final TextEditingController searchCtrl;
  final ValueChanged<String> onSearchChanged;

  const _TopBar({required this.searchCtrl, required this.onSearchChanged});

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final selectedOutlet = ref.watch(selectedOutletProvider);
    final cart = ref.watch(issueCartProvider);

    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 14),
      decoration: const BoxDecoration(
        color: Colors.white,
        border: Border(bottom: BorderSide(color: AppColors.kDivider)),
      ),
      child: Row(
        children: [
          // Title block
          Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Text('POS Outlet Issue',
                  style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold, color: AppColors.kTextPrimary)),
              const SizedBox(height: 2),
              Text(
                'Issues branch-store stock into a selling outlet\'s counter',
                style: const TextStyle(fontSize: 12, color: AppColors.kTextSecondary),
              ),
            ],
          ),
          const SizedBox(width: 32),
          // Search
          SizedBox(
            width: 280,
            height: 40,
            child: TextField(
              controller: searchCtrl,
              onChanged: onSearchChanged,
              decoration: InputDecoration(
                hintText: selectedOutlet != null
                    ? 'Search ${selectedOutlet.name} stock...'
                    : 'Search branch stock...',
                prefixIcon: Icon(PhosphorIcons.magnifyingGlass(), size: 18),
                contentPadding: const EdgeInsets.symmetric(vertical: 0, horizontal: 12),
                isDense: true,
              ),
            ),
          ),
          const Spacer(),
          // Refresh
          OutlinedButton.icon(
            onPressed: () {
              ref.invalidate(posOutletsProvider);
              ref.invalidate(branchStockProvider);
              if (selectedOutlet != null) {
                ref.invalidate(outletStockProvider(selectedOutlet.id));
                ref.invalidate(stockMovementsProvider(selectedOutlet.id));
              }
            },
            icon: Icon(PhosphorIcons.arrowClockwise(), size: 16),
            label: const Text('Refresh'),
            style: OutlinedButton.styleFrom(
              side: const BorderSide(color: AppColors.kDivider),
              foregroundColor: AppColors.kTextSecondary,
              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
            ),
          ),
          const SizedBox(width: 10),
          // Issue button
          ElevatedButton.icon(
            onPressed: cart.isEmpty || selectedOutlet == null ? null : () => _showIssueConfirmDialog(context, ref, selectedOutlet, cart),
            icon: Icon(PhosphorIcons.arrowBendDownRight(), size: 16),
            label: Text('Issue to ${selectedOutlet?.name ?? 'POS Outlet'} (${cart.length})'),
            style: ElevatedButton.styleFrom(
              backgroundColor: AppColors.kPrimary,
              disabledBackgroundColor: AppColors.kDivider,
              padding: const EdgeInsets.symmetric(horizontal: 18, vertical: 10),
              minimumSize: Size.zero,
            ),
          ),
          const SizedBox(width: 10),
          // Production Ledger
          OutlinedButton.icon(
            onPressed: () => _showMovementsSheet(context),
            icon: Icon(PhosphorIcons.clipboardText(), size: 16),
            label: const Text('Production Ledger'),
            style: OutlinedButton.styleFrom(
              side: const BorderSide(color: AppColors.kDivider),
              foregroundColor: AppColors.kTextSecondary,
              padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
            ),
          ),
        ],
      ),
    );
  }

  void _showMovementsSheet(BuildContext context) {
    showModalBottomSheet(
      context: context,
      isScrollControlled: true,
      backgroundColor: Colors.white,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(16)),
      ),
      builder: (_) => const _ProductionLedgerSheet(),
    );
  }

  void _showIssueConfirmDialog(BuildContext context, WidgetRef ref, PosOutlet outlet, List<IssueCartItem> cart) {
    showDialog(
      context: context,
      builder: (ctx) => _IssueConfirmDialog(outlet: outlet, cart: cart, onConfirmed: (notes) async {
        final items = cart.map((c) => {
          'sku': c.stockItem.sku,
          'quantity': c.quantity,
          'item_name': c.stockItem.itemName,
          'unit': c.stockItem.unit,
        }).toList();
        try {
          await BranchStorekeeperApiService.issueToOutlet(outletId: outlet.id, items: items, notes: notes);
          ref.read(issueCartProvider.notifier).state = [];
          ref.invalidate(branchStockProvider);
          ref.invalidate(outletStockProvider(outlet.id));
          ref.invalidate(stockMovementsProvider(outlet.id));
          if (ctx.mounted) {
            Navigator.of(ctx).pop();
            ScaffoldMessenger.of(context).showSnackBar(
              SnackBar(
                content: Row(children: [
                  Icon(PhosphorIcons.checkCircle(), color: Colors.white, size: 18),
                  const SizedBox(width: 8),
                  Text('Stock issued to ${outlet.name} successfully'),
                ]),
                backgroundColor: AppColors.kSuccess,
                duration: const Duration(seconds: 3),
              ),
            );
          }
        } catch (e) {
          if (ctx.mounted) {
            ScaffoldMessenger.of(context).showSnackBar(
              SnackBar(content: Text('Issue failed: $e'), backgroundColor: AppColors.kError),
            );
          }
        }
      }),
    );
  }
}

