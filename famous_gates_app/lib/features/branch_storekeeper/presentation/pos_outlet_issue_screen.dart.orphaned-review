  @override
  ConsumerState<_AddToCartDialog> createState() => _AddToCartDialogState();
}

class _AddToCartDialogState extends ConsumerState<_AddToCartDialog> {
  late final TextEditingController _qtyCtrl;
  double _qty = 1;

  @override
  void initState() {
    super.initState();
    _qtyCtrl = TextEditingController(text: '1');
  }

  @override
  void dispose() {
    _qtyCtrl.dispose();
    super.dispose();
  }

  void _addToCart() {
    final parsed = double.tryParse(_qtyCtrl.text);
    if (parsed == null || parsed <= 0) {
      ScaffoldMessenger.of(context).showSnackBar(const SnackBar(
          content: Text('Enter a valid quantity'), backgroundColor: AppColors.kError));
      return;
    }
    if (parsed > widget.item.quantity) {
      ScaffoldMessenger.of(context).showSnackBar(SnackBar(
          content: Text('Cannot exceed store stock (${widget.item.quantity} ${widget.item.unit})'),
          backgroundColor: AppColors.kError));
      return;
    }
    final current = ref.read(issueCartProvider);
    // If already in cart, update qty
    final existingIdx = current.indexWhere((c) => c.stockItem.sku == widget.item.sku);
    if (existingIdx >= 0) {
      final updated = List<IssueCartItem>.from(current);
      updated[existingIdx].quantity = parsed;
      ref.read(issueCartProvider.notifier).state = updated;
    } else {
      ref.read(issueCartProvider.notifier).state = [
        ...current,
        IssueCartItem(
          stockItem: widget.item,
          quantity: parsed,
          targetOutletId: widget.outlet.id,
          targetOutletName: widget.outlet.name,
        ),
      ];
    }
    Navigator.of(context).pop();
  }

  @override
  Widget build(BuildContext context) {
    return AlertDialog(
      title: Row(children: [
        Icon(PhosphorIcons.arrowBendDownRight(), size: 20, color: AppColors.kPrimary),
        const SizedBox(width: 8),
        const Expanded(child: Text('Add to Issue Cart')),
      ]),
      content: SizedBox(
        width: 360,
        child: Column(mainAxisSize: MainAxisSize.min, children: [
          // Item info card
          Container(
            padding: const EdgeInsets.all(12),
            decoration: BoxDecoration(
              color: AppColors.kSurface,
              borderRadius: BorderRadius.circular(8),
              border: Border.all(color: AppColors.kDivider),
            ),
            child: Column(children: [
              Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
                const Text('Item:', style: TextStyle(fontSize: 12, color: AppColors.kTextSecondary)),
                Expanded(child: Text(widget.item.itemName,
                    style: const TextStyle(fontSize: 13, fontWeight: FontWeight.bold),
                    textAlign: TextAlign.right)),
              ]),
              const SizedBox(height: 4),
              Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
                const Text('SKU:', style: TextStyle(fontSize: 12, color: AppColors.kTextSecondary)),
                Text(widget.item.sku,
                    style: const TextStyle(fontSize: 12, fontFamily: 'monospace')),
              ]),
              const SizedBox(height: 4),
              Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
                const Text('In Store:', style: TextStyle(fontSize: 12, color: AppColors.kTextSecondary)),
                Text('${widget.item.quantity} ${widget.item.unit}',
                    style: const TextStyle(fontSize: 13, fontWeight: FontWeight.bold,
                        color: AppColors.kSuccess)),
              ]),
              const SizedBox(height: 4),
              Row(mainAxisAlignment: MainAxisAlignment.spaceBetween, children: [
                const Text('Outlet:', style: TextStyle(fontSize: 12, color: AppColors.kTextSecondary)),
                Row(children: [
                  Icon(PhosphorIcons.arrowRight(), size: 12, color: AppColors.kPrimary),
                  const SizedBox(width: 4),
                  Text(widget.outlet.name,
                      style: const TextStyle(fontSize: 13, color: AppColors.kPrimary,
                          fontWeight: FontWeight.bold)),
                ]),
              ]),
            ]),
          ),
          const SizedBox(height: 16),
          // Quantity input
          Row(children: [
            _QtyButton(icon: PhosphorIcons.minus(), onTap: () {
              final v = double.tryParse(_qtyCtrl.text) ?? 1;
              if (v > 1) {
                setState(() { _qty = v - 1; _qtyCtrl.text = _qty.toStringAsFixed(0); });
              }
            }),
            const SizedBox(width: 12),
            Expanded(
              child: TextField(
                controller: _qtyCtrl,
                keyboardType: const TextInputType.numberWithOptions(decimal: true),
                textAlign: TextAlign.center,
                style: const TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
                decoration: InputDecoration(
                  labelText: 'Quantity (${widget.item.unit})',
                  border: const OutlineInputBorder(),
                ),
                onChanged: (v) => setState(() => _qty = double.tryParse(v) ?? _qty),
              ),
            ),
            const SizedBox(width: 12),
            _QtyButton(icon: PhosphorIcons.plus(), onTap: () {
              final v = double.tryParse(_qtyCtrl.text) ?? 1;
