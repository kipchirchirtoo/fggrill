# FamousGate Flutter App Environment Variables
#
# Flutter uses compile-time variables via --dart-define.
# Example:
#   flutter run --dart-define=POWERSYNC_ENABLED=true \
#               --dart-define=POWERSYNC_URL=https://your-tenant.powersync.com \
#               --dart-define=MAIN_API_URL=https://api.hirall.com/api
#
# For local development, you can also use an .env file with the flutter_dotenv
# package, but this project currently reads variables via --dart-define.

# PowerSync offline sync service (JourneyApps instance)
POWERSYNC_ENABLED=true
POWERSYNC_HOT_READS_ENABLED=true
POWERSYNC_URL=https://6a3baa5435ca576ca0df47ea.powersync.journeyapps.com
# Optional: dashboard-generated client token. If set, the app uses it directly
# instead of calling /powersync/credentials. Useful for quick setup.
POWERSYNC_TOKEN=your_powersync_client_token

# Main backend API
MAIN_API_URL=https://api.hirall.com/api

# Python microservices
PYTHON_SERVICES_URL=https://services.hirall.com
