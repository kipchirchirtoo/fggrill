# Environment Configuration Template
# FamousGates Hotels Landing Page
# Copy this file to .env.development, .env.staging, or .env.production

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_API_TIMEOUT=10000

# Environment (development, staging, production)
NEXT_PUBLIC_ENVIRONMENT=development

# Feature Flags
NEXT_PUBLIC_ENABLE_BOOKING=true
NEXT_PUBLIC_ENABLE_SEARCH=true

# Cache Configuration (in minutes)
NEXT_PUBLIC_CACHE_TTL=5

# Retry Configuration
NEXT_PUBLIC_API_MAX_RETRIES=3
NEXT_PUBLIC_API_RETRY_DELAY=1000

# Image Configuration
NEXT_PUBLIC_IMAGE_QUALITY=85
NEXT_PUBLIC_ENABLE_IMAGE_OPTIMIZATION=true

# Performance Configuration
NEXT_PUBLIC_ENABLE_LAZY_LOADING=true
NEXT_PUBLIC_PAGE_LOAD_TIMEOUT=3000

# Error Handling
NEXT_PUBLIC_ENABLE_ERROR_LOGGING=true
NEXT_PUBLIC_SHOW_ERROR_DETAILS=true

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=your-google-analytics-id
# NEXT_PUBLIC_GTM_ID=your-google-tag-manager-id

# Monitoring (optional)
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
