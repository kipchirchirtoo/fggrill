# Production Environment Configuration
# FamousGates Hotels Landing Page

# API Configuration
# Production backend URL
NEXT_PUBLIC_API_BASE_URL=https://api.hirall.com/api
NEXT_PUBLIC_API_TIMEOUT=10000

# Environment
NEXT_PUBLIC_ENVIRONMENT=production

# Feature Flags
NEXT_PUBLIC_ENABLE_BOOKING=true
NEXT_PUBLIC_ENABLE_SEARCH=true

# Cache Configuration (in minutes)
NEXT_PUBLIC_CACHE_TTL=5

# Retry Configuration
NEXT_PUBLIC_API_MAX_RETRIES=3
NEXT_PUBLIC_API_RETRY_DELAY=1000

# Image Configuration
NEXT_PUBLIC_IMAGE_QUALITY=90
NEXT_PUBLIC_ENABLE_IMAGE_OPTIMIZATION=true

# Performance Configuration
NEXT_PUBLIC_ENABLE_LAZY_LOADING=true
NEXT_PUBLIC_PAGE_LOAD_TIMEOUT=3000

# Error Handling
NEXT_PUBLIC_ENABLE_ERROR_LOGGING=true
NEXT_PUBLIC_SHOW_ERROR_DETAILS=false

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_GTM_ID=

# Monitoring (optional)
# NEXT_PUBLIC_SENTRY_DSN=

# Brevo Email Configuration (Standalone for Landing Page)
BREVO_API_KEY=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
BREVO_SENDER_EMAIL=info@famousgateshotels.com
BREVO_SENDER_NAME=FamousGate Hotels
