{
  "name": "fggrill-central",
  "version": "1.0.28",
  "author": {
    "name": "HIRALL",
    "email": "info@famousgate.com"
  },
  "description": "Famous Gate Hotel Management System",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/allan-too/fggrill.git"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.95.3",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^17.2.4",
    "electron-is-dev": "^2.0.0",
    "electron-updater": "^6.7.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.fggrill.terminal",
    "productName": "FG Grill Terminal",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "dist/**/*",
          "node_modules/**/*",
          ".env.offline"
        ]
      },
      {
        "from": "frontend/.next/standalone",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "frontend/public",
        "to": "frontend/public"
      },
      {
        "from": "frontend/.next/static",
        "to": "frontend/.next/static"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "allan-too",
        "repo": "fggrill"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "frontend/public/fglogo.ico",
      "publisherName": "HIRALL"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FG Grill Terminal"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "frontend/public/fg_grill_official_icon.png"
    }
  },
  "scripts": {
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "release": "electron-builder --win --linux -p always",
    "electron:dev": "set ELECTRON_IS_DEV=1 && set NODE_ENV=development && electron .",
    "electron:start": "set NODE_ENV=production && electron .",
    "rebuild:sqlite": "npx @electron/rebuild -f -w better-sqlite3"
  }
}