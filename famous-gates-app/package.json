{
  "name": "famous-gates-hotels",
  "version": "1.0.0",
  "description": "Famous Gates Hotels Management System",
  "main": "main.js",
  "author": "Hirall Systems",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.hirall.famousgates",
    "productName": "Famous Gates Hotels",
    "icon": "icon.png",
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icon.png",
      "signingHashAlgorithms": null,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Famous Gates Hotels"
    },
    "files": ["main.js", "preload.js", "offline.html", "icon.png", "icon.ico"],
    "extraResources": [{ "from": "icon.png", "to": "icon.png" }]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
