{
  "identifier": "pos-window",
  "description": "Restricted permissions for the POS terminal window",
  "windows": ["pos"],
  "permissions": [
    "core:default",
    "http:default",
    "notification:default",
    "sql:default",
    "store:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:event:allow-listen",
    "core:event:allow-emit"
  ]
}
