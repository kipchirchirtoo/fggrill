# ═══════════════════════════════════════════════════════════════════════════════
# Famous Gates Hotels — Desktop App Environment Variables
# Copy this file to .env and fill in your values
# VITE_ prefix = exposed to the frontend (React)
# Non-prefixed = Tauri/Rust side only (never exposed to renderer)
# ═══════════════════════════════════════════════════════════════════════════════


# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL (same as SUPABASE_PROJECT_URL in backend)
VITE_SUPABASE_URL=https://utsvlihpudfraxzcmtle.supabase.co

# Anon/public key — safe to expose to the renderer
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InV0c3ZsaWhwdWRmcmF4emNtdGxlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjM5MTYzMzIsImV4cCI6MjA3OTQ5MjMzMn0.wPONqSZvgQQyrssA4wTbBfaUJO5HrV_XtA2AD7PaweA

# Service role key — used by Rust/backend only, NEVER expose to renderer
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InV0c3ZsaWhwdWRmcmF4emNtdGxlIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2MzkxNjMzMiwiZXhwIjoyMDc5NDkyMzMyfQ.AhnRNBw6l3HBOTEIMrlUbGQEf9FJdyTaQrRQJW7IBNY

# JWT secret for token verification (backend/Rust side)
SUPABASE_JWT_SECRET=your-jwt-secret


# ── Node.js API (backend) ─────────────────────────────────────────────────────
# Production
VITE_NODE_API_URL=https://api.hirall.com
# Local dev override
# VITE_NODE_API_URL=http://localhost:5000


# ── Python Analytics / Services API ──────────────────────────────────────────
# Production
VITE_PYTHON_API_URL=https://services.hirall.com
# Local dev override
# VITE_PYTHON_API_URL=http://localhost:5001

# Aliases (all point to the same Python service)
VITE_PYTHON_SERVICE_URL=https://services.hirall.com
VITE_REPORTS_SERVICE_URL=https://services.hirall.com
VITE_ANALYTICS_SERVICE_URL=https://services.hirall.com
VITE_ROOM_SERVICE_URL=https://services.hirall.com
VITE_EMAIL_AUTOMATION_SERVICE_URL=https://services.hirall.com
VITE_TEMPLATE_GENERATOR_SERVICE_URL=https://services.hirall.com
VITE_BARCODE_SERVICE_URL=https://services.hirall.com


# ── PowerSync (offline sync) ──────────────────────────────────────────────────
VITE_POWERSYNC_URL=https://699224f042bd91af920c6b3c.powersync.journeyapps.com


# ── Database (direct Postgres — Rust/backend side only) ───────────────────────
DATABASE_URL=postgresql://postgres.utsvlihpudfraxzcmtle:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres


# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d


# ── Email — Brevo (SMTP) ──────────────────────────────────────────────────────
BREVO_API_KEY=your_brevo_api_key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=info@famousgateshotels.com
SMTP_PASS=your_brevo_smtp_password
SMTP_FROM_NAME=FamousGate Hotels
SMTP_FROM_EMAIL=info@famousgateshotels.com


# ── SMS — Twilio ──────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number


# ── Payments — Stripe ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret


# ── Payments — Paystack ───────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_WEBHOOK_URL=https://your-domain.com/api/payments/paystack/webhook
PAYSTACK_CALLBACK_URL=https://your-domain.com/api/payments/paystack/callback
PAYSTACK_SUCCESS_URL=https://your-domain.com/booking/confirmation
PAYSTACK_CANCEL_URL=https://your-domain.com/booking


# ── Payments — M-Pesa ─────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_ENVIRONMENT=sandbox
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
MPESA_INITIATOR_NAME=your_initiator_name
MPESA_INITIATOR_PASSWORD=your_initiator_password
MPESA_SECURITY_CREDENTIAL=your_security_credential
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/mpesa/callback
MPESA_TIMEOUT_URL=https://your-domain.com/api/payments/mpesa/timeout
MPESA_RESULT_URL=https://your-domain.com/api/payments/mpesa/result


# ── AI / Gemini ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key


# ── Redis (caching & sessions) ────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379


# ── External Booking Channels ─────────────────────────────────────────────────
BOOKING_COM_API_KEY=your_booking_com_api_key
EXPEDIA_API_KEY=your_expedia_api_key


# ── App / Frontend URLs ───────────────────────────────────────────────────────
VITE_APP_NAME=Famous Gates Hotels
VITE_APP_VERSION=1.0.0
VITE_BASE_URL=http://localhost:1420
FRONTEND_URL=http://localhost:3001
LANDING_PAGE_URL=http://localhost:3000
LANDING_PAGE_PRODUCTION_URL=https://famousgatehotels.com


# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880


# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100


# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_FILE=logs/app.log


# ── Sync ─────────────────────────────────────────────────────────────────────
VITE_SYNC_INTERVAL_MS=30000
VITE_OUTBOX_RETRY_LIMIT=5


# ── Server (Node backend) ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
