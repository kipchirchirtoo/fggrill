  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "build": "tsc --skipLibCheck",
    "postinstall": "tsc --skipLibCheck || echo 'Build failed but continuing'",
    "lint": "eslint . --ext .ts",
