# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://your-database-url

# Clean Database Rebuild / Cutover
# Use these only for the clean rebuild workflow. Keep actual secrets in backend/.env.
DATABASE_URL_OLD=postgresql://your-current-database-url
DATABASE_URL_NEW=postgresql://your-new-clean-database-url
SUPABASE_OLD_URL=https://your-current-project.supabase.co
SUPABASE_NEW_URL=https://your-new-project.supabase.co
SUPABASE_NEW_REST_URL=https://your-new-project.supabase.co/rest/v1
SUPABASE_OLD_SERVICE_ROLE_KEY=your-current-service-role-key
SUPABASE_NEW_SERVICE_ROLE_KEY=your-new-service-role-key
SUPABASE_NEW_ANON_KEY=your-new-anon-key
SUPABASE_NEW_PUBLISHABLE_KEY=your-new-publishable-key
SUPABASE_COLUMNS_CSV=/home/john/Downloads/Supabase Snippet List Columns with Estimated Row Counts.csv
SUPABASE_SNAPSHOT_CSV=/home/john/Downloads/Supabase Snippet Full Database Snapshot Dump.csv

# Supabase Configuration
SUPABASE_PROJECT_URL=your-project-url
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# JWT Configuration
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d

# ──────────────────────────────────────────────────────────────────────────────
# Email Configuration — Brevo SMTP Relay
# ──────────────────────────────────────────────────────────────────────────────
#
# SETUP STEPS:
#  1. Log in to https://app.brevo.com → SMTP & API → SMTP
#  2. Generate a NEW SMTP Key (distinct from your API key).
#     Store it only here – never commit to git.
#  3. Set BREVO_SMTP_USER to the LOGIN email shown in the Brevo SMTP settings.
#  4. Set BREVO_SMTP_KEY to the SMTP key you just generated.
#  5. Set BREVO_API_KEY to your Transactional API key (for brevo-email.service).
#
# SECURITY NOTES:
#  • BREVO_SMTP_KEY and BREVO_API_KEY are NOT the same – use the correct one.
#  • Never share or log these values – rotate them immediately if compromised.
#  • Brevo free tier allows 300 emails/day; monitor your sending quota.
#  • Enable 2FA on your Brevo account at https://app.brevo.com/profile/security.
#  • Configure SPF/DKIM/DMARC for famousgatehotels.com in your DNS provider
#    (records are shown in Brevo → Senders & IPs → Domains).
#
# TLS SETTINGS (do not change these in production):
#  SMTP_PORT=587 uses STARTTLS (recommended). Port 465 uses implicit TLS.
#  SMTP_TLS_REJECT_UNAUTHORIZED must remain 'true' in production.
# ──────────────────────────────────────────────────────────────────────────────

# Brevo SMTP credentials (generate at https://app.brevo.com → SMTP & API → SMTP)
BREVO_SMTP_USER=your-brevo-login-email@example.com
BREVO_SMTP_KEY=your-brevo-smtp-key

# Brevo Transactional API key (used by brevo-email.service.ts for REST API)
BREVO_API_KEY=your-brevo-api-key

# SMTP relay settings — Brevo values, do not change host/port
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false

# Sender identity (must match a verified sender/domain in Brevo)
SMTP_FROM_EMAIL=info@famousgatehotels.com
SMTP_FROM_NAME=Famous Gate Hotels

# TLS enforcement — NEVER set to false in production
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Admin alert email for system notifications (stock transfers, alerts, etc.)
ADMIN_EMAIL=admin@famousgatehotels.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Payment Configuration (Stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Payment Configuration (Paystack)
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# Payment Configuration (M-Pesa)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_ENVIRONMENT=sandbox
MPESA_SHORTCODE=your_business_shortcode
MPESA_PASSKEY=your_passkey
MPESA_INITIATOR_NAME=your_initiator_name
MPESA_INITIATOR_PASSWORD=your_initiator_password
MPESA_SECURITY_CREDENTIAL=your_security_credential
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/callback
MPESA_TIMEOUT_URL=https://yourdomain.com/api/payments/mpesa/timeout
MPESA_RESULT_URL=https://yourdomain.com/api/payments/mpesa/result

# Python Microservices
PYTHON_SERVICE_URL=https://services.hirall.com
PRICING_SERVICE_URL=https://services.hirall.com
COMMUNICATION_SERVICE_URL=https://services.hirall.com

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880 # 5MB

# Rate Limiting
RATE_LIMIT_WINDOW=15m
RATE_LIMIT_MAX=100

# Redis Configuration (for caching & sessions)
REDIS_URL=redis://localhost:6379

# External APIs
BOOKING_COM_API_KEY=your_booking_com_api_key
EXPEDIA_API_KEY=your_expedia_api_key

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# PowerSync Configuration
# PowerSync sync service endpoint (JourneyApps instance)
POWERSYNC_URL=https://6a3baa5435ca576ca0df47ea.powersync.journeyapps.com

# Development: shared secret for HS256 tokens (fallback when no RSA key is configured)
POWERSYNC_JWT_SECRET=your_powersync_jwt_secret

# Production: RSA key pair for RS256 + JWKS auth
# Generate with: node scripts/generate-powersync-keys.js
# POWERSYNC_PRIVATE_KEY_PATH=./powersync/private.pem
# POWERSYNC_PUBLIC_KEY_PATH=./powersync/public.pem
# POWERSYNC_KEY_ID=powersync-key-1
