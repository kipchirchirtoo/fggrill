# Python Report Service Configuration
PYTHON_SERVICE_PORT=5001
FLASK_ENV=development

# Backend API
BACKEND_URL=http://localhost:5000/api
API_KEY=your_api_key_here

# Supabase Configuration
SUPABASE_URL=https://utsvlihpudfraxzcmtle.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here

# Email Configuration (for scheduled reports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=reports@famousgate.co.ke
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=reports@famousgate.co.ke

# Report Output
REPORT_OUTPUT_DIR=/tmp/reports
ENABLE_SCHEDULER=true

# Thermal Printer Configuration (for kitchen captain orders)
# Connection type: network, usb, or serial
THERMAL_PRINTER_CONNECTION_TYPE=network
# Network printer settings (if connection_type=network)
THERMAL_PRINTER_IP=192.168.1.100
THERMAL_PRINTER_PORT=9100
# USB printer settings (if connection_type=usb)
THERMAL_PRINTER_USB_VENDOR=0x04b8
THERMAL_PRINTER_USB_PRODUCT=0x0202
# Serial printer settings (if connection_type=serial)
THERMAL_PRINTER_SERIAL_PORT=/dev/ttyUSB0
THERMAL_PRINTER_SERIAL_BAUDRATE=9600

# AI API Keys (optional)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
